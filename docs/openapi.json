  "components": {
    "schemas": {
      "CreateKaryawan": {
        "properties": {
          "nama": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Nama"
          },
          "cabang": {
            "type": "string",
            "maxLength": 30,
            "minLength": 1,
            "title": "Cabang"
          },
          "no_telp": {
            "type": "string",
            "pattern": "^[0-9]{1,20}$",
            "title": "No Telp"
          },
          "status": {
            "type": "string",
            "maxLength": 10,
            "minLength": 1,
            "title": "Status"
          },
          "id_karyawan": {
            "type": "string",
            "pattern": "^[0-9]{1,5}$",
            "title": "Id Karyawan"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nama",
          "cabang",
          "no_telp",
          "status",
          "id_karyawan"
        ],
        "title": "CreateKaryawan"
      },
      "ErrorResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "const": false,
            "title": "Success",
            "default": false
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "data": {
            "type": "null",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "HealthData": {
        "properties": {
          "status": {
            "type": "string",
            "const": "alive",
            "title": "Status",
            "default": "alive"
          }
        },
        "type": "object",
        "title": "HealthData"
      },
      "HealthResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "const": true,
            "title": "Success",
            "default": true
          },
          "code": {
            "type": "string",
            "const": "SUCCESS",
            "title": "Code",
            "default": "SUCCESS"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "data": {
            "$ref": "#/components/schemas/HealthData"
          }
        },
        "type": "object",
        "required": [
          "message",
          "data"
        ],
        "title": "HealthResponse"
      },
      "KaryawanData": {
        "properties": {
          "id_karyawan": {
            "type": "string",
            "pattern": "^[0-9]{1,5}$",
            "title": "Id Karyawan"
          },
          "nama": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nama"
          },
          "cabang": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cabang"
          },
          "no_telp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "No Telp"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id_karyawan"
        ],
        "title": "KaryawanData"
      },
      "OracleResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "code": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "pattern": "^[A-Z0-9_]+$",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Message"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/KaryawanData"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "success",
          "code",
          "message",
          "data"
        ],
        "title": "OracleResponse"
      },
      "UpdateKaryawan": {
        "properties": {
          "nama": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Nama"
          },
          "cabang": {
            "type": "string",
            "maxLength": 30,
            "minLength": 1,
            "title": "Cabang"
          },
          "no_telp": {
            "type": "string",
            "pattern": "^[0-9]{1,20}$",
            "title": "No Telp"
          },
          "status": {
            "type": "string",
            "maxLength": 10,
            "minLength": 1,
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nama",
          "cabang",
          "no_telp",
          "status"
        ],
        "title": "UpdateKaryawan"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
