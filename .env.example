# Template only. Never commit the populated runtime .env.
ENVIRONMENT=development
BIND_HOST=127.0.0.1
PORT=8000
# DOCS_ENABLED defaults to true in development/test, false in production.
# DOCS_ENABLED=false

# Supply all three together through a private runtime profile. TCPS is required.
ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_MODE=thin
# Thick requires a compatible client, an explicit library path and a separate image.
# ORACLE_MODE=thick
# ORACLE_CLIENT_LIB_DIR=/opt/oracle/instantclient
# Mount trusted wallet files read-only; do not bake them into the image.
# ORACLE_WALLET_DIR=/run/oracle-wallet
ORACLE_WALLET_PASSWORD=
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=5
ORACLE_POOL_INCREMENT=1
ORACLE_POOL_WAIT_MS=5000
ORACLE_CONNECT_TIMEOUT=5
ORACLE_CALL_TIMEOUT_MS=5000

# Operator-only profile: never provide writer credentials to the API container.
ORACLE_WRITER_USER=
ORACLE_WRITER_PASSWORD=
OPERATOR_AUTHORIZED=false
# Local encrypted store is development-only, outside this project.
KEY_SECRET_STORE_DIR=
# Choose exactly one encryption-key source. Prefer a private file.
KEY_ENCRYPTION_KEY=
KEY_ENCRYPTION_KEY_FILE=
